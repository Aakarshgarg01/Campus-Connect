# Copy to backend/.env and fill in real values. backend/.env is git-ignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Dedicated MySQL user (never root). URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://sp_app:CHANGE_ME@127.0.0.1:3306/student_predictor?charset=utf8mb4
# Separate, disposable database used only by pytest (tables are dropped and recreated).
TEST_DATABASE_URL=mysql+pymysql://sp_app:CHANGE_ME@127.0.0.1:3306/student_predictor_test?charset=utf8mb4
# Production only: path to the managed MySQL provider's CA certificate. Leave empty locally.
DB_SSL_CA=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT=5/minute

# Exact frontend origins, comma-separated (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
