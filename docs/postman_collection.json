{
  "info": {
    "name": "Student Performance Predictor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl, identifier and password (faculty account created with `python -m app.cli create-user`). Login stores the JWT in {{token}}."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "identifier",
      "value": "FAC1024"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    },
    {
      "key": "predictionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health & model",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 when DB and models are ready', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/model-info",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/model-info",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "GET /api/feature-importance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/feature-importance",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register (student)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Student\",\n  \"email\": \"demo.student@yourcollege.edu\",\n  \"password\": \"ChangeMe123\",\n  \"roll_number\": \"DEMO001\",\n  \"department\": \"Computer Science\",\n  \"semester\": 7\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{identifier}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Students (faculty/admin)",
      "item": [
        {
          "name": "POST /api/students/",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/students/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"CS21050\",\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"ravi@yourcollege.edu\",\n  \"department\": \"Computer Science\",\n  \"semester\": 7\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('studentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/students/",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/?search=&limit=50&offset=0",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/students/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PUT /api/students/{id}",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semester\": 8\n}"
            }
          }
        },
        {
          "name": "PUT /api/students/{id}/academic",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}/academic",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"semester\": 8,\n  \"attendance_percentage\": 82.5,\n  \"records\": [\n    {\n      \"subject_name\": \"Computer Networks\",\n      \"internal1\": {\n        \"obtained\": 30,\n        \"maximum\": 40\n      },\n      \"internal2\": {\n        \"obtained\": 33,\n        \"maximum\": 40\n      },\n      \"assignment\": {\n        \"obtained\": 8,\n        \"maximum\": 10\n      }\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "GET /api/students/{id}/academic",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}/academic",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/faculty/overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/faculty/overview",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Predictions",
      "item": [
        {
          "name": "POST predict (manual inputs, stage 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/predictions/predict",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{studentId}},\n  \"stage\": \"stage2\",\n  \"inputs\": {\n    \"attendance\": 85,\n    \"internal1\": 80,\n    \"internal2\": 82.5,\n    \"assignment\": 75\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('predictionId', pm.response.json().id);",
                  "pm.test('SHAP additivity', () => { const e = pm.response.json().shap_explanation;",
                  "  const total = e.base_value + e.contributions.reduce((s, c) => s + c.shap_value, 0);",
                  "  pm.expect(Math.abs(total - e.raw_prediction)).to.be.below(0.001); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST predict (from stored records)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/predictions/predict",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{studentId}},\n  \"stage\": \"stage2\"\n}"
            }
          }
        },
        {
          "name": "POST predict (invalid -> 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/predictions/predict",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": {{studentId}},\n  \"stage\": \"stage1\",\n  \"inputs\": {\n    \"attendance\": 120,\n    \"internal1\": 80,\n    \"assignment\": 75\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST simulate (not saved)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/predictions/simulate",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage\": \"stage1\",\n  \"inputs\": {\n    \"attendance\": 60,\n    \"internal1\": 60,\n    \"assignment\": 60\n  }\n}"
            }
          }
        },
        {
          "name": "GET history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/predictions/history/{{studentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET prediction by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/predictions/{{predictionId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "DELETE /api/students/{id}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/students/{{studentId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
